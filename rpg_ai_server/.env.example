# Redis Configuration (host/port/DBs: unused local fallback — production uses Upstash REST below)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_INPUT_DB=0
REDIS_OUTPUT_DB=1
REDIS_PASSWORD=
REDIS_TTL_SECONDS=3600

# Upstash Redis (single instance; queue/state/output separated by input:/output:/games: prefixes)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash Search (game memory — shared index, games filtered by sid)
UPSTASH_SEARCH_REST_URL=
UPSTASH_SEARCH_REST_TOKEN=
SEARCH_INDEX_NAME=game-memory
SEARCH_TOP_K=3
SEARCH_RERANKING=false
SEARCH_SEMANTIC_WEIGHT=0.75
SEARCH_INPUT_ENRICHMENT=true
SEARCH_CHUNK_MAX_TOKENS=512
SEARCH_CHUNK_OVERLAP_TOKENS=32

# OpenRouter API (all LLM calls — no Gemini SDK)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini API — removed (legacy). Node1 uses Scrapy lore scrape over SRD sources, no key needed.

# Model Configuration (all OpenRouter-only)
CLASSIFIER_MODEL=liquid/lfm-2.5-2.6b:free
# GEMINI_MODEL — legacy, unused (all LLM via OpenRouter)
IMAGE_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
REDESCRIPTION_MODEL=google/gemma-4-26b-a4b-it:free
TOOL_AGENT_MODEL=qwen/qwen3.8-27b:free
CONTEXT_INJECTOR_MODEL=google/gemma-4-31b-it:free
STORY_MODEL=qwen/qwen3.8-27b:free

# Scraper (Node1 Scrapy lore search)
SCRAPER_USER_AGENT=RPG-AI-Server/1.0 (+local)
SCRAPER_TIMEOUT_SECONDS=15.0
SCRAPER_CACHE_TTL_SECONDS=86400

# System Configuration
MAX_CONCURRENT_REQUESTS=16
OUTPUT_MEMORY_THRESHOLD=90.0
BACKOFF_SECONDS=3.0
LOG_LEVEL=INFO

# Loop Guards
LOOP_RECURSION_LIMIT=60
ROUTER_MAX_PASSES=3
MAX_TOOL_CALLS=15
REQUEST_TIMEOUT_SECONDS=60.0
MAX_LLM_CALLS_PER_TURN=12
CONTEXT_MAX_CHARS=8000
CHAT_LOG_MAX_TURNS=40
DRAIN_THRESHOLD=25
REMAINING_STEPS_MIN=10
LOCK_TTL_SECONDS=30
LOCK_REFRESH_INTERVAL=10.0
