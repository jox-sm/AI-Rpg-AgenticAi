# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_INPUT_DB=0
REDIS_OUTPUT_DB=1
REDIS_PASSWORD=
REDIS_TTL_SECONDS=3600

# Upstash Search (game memory — shared index, games filtered by sid)
UPSTASH_SEARCH_REST_URL=
UPSTASH_SEARCH_REST_TOKEN=
SEARCH_INDEX_NAME=game-memory
SEARCH_TOP_K=3
SEARCH_RERANKING=false
SEARCH_SEMANTIC_WEIGHT=0.75
SEARCH_INPUT_ENRICHMENT=true
SEARCH_CHUNK_MAX_TOKENS=512
SEARCH_CHUNK_OVERLAP_TOKENS=32

# OpenRouter API (for all models except Gemini)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini API (for web search node)
GOOGLE_API_KEY=your-google-gemini-key

# Model Configuration
GEMINI_MODEL=gemini-2.0-flash
IMAGE_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
REDESCRIPTION_MODEL=openrouter/owl-alpha
TOOL_AGENT_MODEL=qwen/qwen3-coder:free
CONTEXT_INJECTOR_MODEL=nvidia/nemotron-3-super-120b-a12b:free
STORY_MODEL=qwen/qwen3-coder:free

# System Configuration
MAX_CONCURRENT_REQUESTS=100
OUTPUT_MEMORY_THRESHOLD=90.0
BACKOFF_SECONDS=3.0
LOG_LEVEL=INFO

# Loop Guards
LOOP_RECURSION_LIMIT=60
ROUTER_MAX_PASSES=4
MAX_TOOL_CALLS=15
REQUEST_TIMEOUT_SECONDS=120.0
REMAINING_STEPS_MIN=10
LOCK_TTL_SECONDS=30
LOCK_REFRESH_INTERVAL=10.0
